@using academic_weapon.Helpers
@model academic_weapon.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Dashboard";
    var now = DateTime.UtcNow;
}

<div class="reveal">

    <div class="page-head d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <div class="page-kicker">Overview</div>
            <h1 class="page-title">Dashboard</h1>
        </div>
        <a asp-controller="Subjects" asp-action="Create" class="btn btn-primary btn-sm">+ Add subject</a>
    </div>

    <!-- Stats -->
    <div class="row mb-4 pb-2">
        <div class="col-md-4">
            <div class="stat">
                <div class="stat-label">Weighted average</div>
                <div class="stat-value">
                    @if (Model.WeightedGpa.HasValue)
                    {
                        <span class="accent">@Model.WeightedGpa.Value.ToString("F1")</span><small>%</small>
                    }
                    else
                    {
                        <span class="accent">—</span>
                    }
                </div>
                <div class="stat-sub">
                    @if (Model.WeightedGpa.HasValue)
                    {
                        <span>≈ grade @GradeHelper.ToFinkiGradeLabel(Model.WeightedGpa.Value) · completed subjects</span>
                    }
                    else
                    {
                        <span>no completed subjects graded yet</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat">
                <div class="stat-label">Credits</div>
                <div class="stat-value">@Model.CompletedCredits<small>/ @Model.TotalCredits</small></div>
                <div class="stat-sub">completed / total ECTS</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat">
                <div class="stat-label">Subjects</div>
                <div class="stat-value">@Model.Subjects.Count(s => !s.IsCompleted)<small>active</small></div>
                <div class="stat-sub">@Model.Subjects.Count(s => s.IsCompleted) finished · @Model.Subjects.Count total</div>
            </div>
        </div>
    </div>

    <!-- Per-semester breakdown -->
    @if (Model.SemesterSummaries.Count > 1)
    {
        <div class="sem-strip mb-4">
            @foreach (var sem in Model.SemesterSummaries)
            {
                <span class="sem-chip">
                    S@(sem.Semester) ·
                    @if (sem.Gpa.HasValue)
                    {
                        <span class="g">@sem.Gpa.Value.ToString("F0")%</span>
                    }
                    else
                    {
                        <b>@sem.CompletedCount/@sem.SubjectCount</b>
                    }
                    · @sem.CompletedCredits/@sem.TotalCredits cr
                </span>
            }
        </div>
    }

    <!-- Upcoming -->
    @if (Model.UpcomingDeadlines.Any() || Model.UpcomingSessions.Any())
    {
        <div class="row g-3 mb-2">
            <div class="col-md-6">
                <div class="panel h-100">
                    <div class="panel-label">Next deadlines</div>
                    @if (!Model.UpcomingDeadlines.Any())
                    {
                        <p class="text-muted mb-0" style="font-size:0.85rem">Nothing due. Enjoy it.</p>
                    }
                    else
                    {
                        @foreach (var item in Model.UpcomingDeadlines)
                        {
                            var daysLeft = (item.Assignment.DueDate.Date - now.Date).Days;
                            var cls = daysLeft < 0 ? "overdue" : daysLeft <= 2 ? "due-soon" : "";
                            <div class="deadline-row">
                                <div>
                                    <div class="row-title">@item.Assignment.Title</div>
                                    <div class="row-meta">@item.SubjectName · @item.Assignment.Type.ToLower()</div>
                                </div>
                                <div class="text-end" style="flex-shrink:0">
                                    <div class="mono @cls" style="font-size:0.78rem">
                                        @(daysLeft < 0 ? $"{-daysLeft}d overdue" : daysLeft == 0 ? "today" : daysLeft == 1 ? "tomorrow" : $"in {daysLeft}d")
                                    </div>
                                    <div class="row-meta">@item.Assignment.DueDate.ToString("MMM d")</div>
                                </div>
                            </div>
                        }
                        <a asp-action="Agenda" class="d-inline-block mt-3" style="font-size:0.78rem">Full agenda →</a>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="panel h-100">
                    <div class="panel-label">Study sessions</div>
                    @if (!Model.UpcomingSessions.Any())
                    {
                        <p class="text-muted mb-0" style="font-size:0.85rem">No sessions planned — schedule one from a subject page.</p>
                    }
                    else
                    {
                        @foreach (var item in Model.UpcomingSessions)
                        {
                            var daysLeft = (item.Session.PlannedDate.Date - now.Date).Days;
                            <div class="session-row">
                                <div>
                                    <div class="row-title">@item.SubjectName</div>
                                    <div class="row-meta">@item.Session.DurationMinutes min@(string.IsNullOrEmpty(item.Session.Notes) ? "" : $" · {item.Session.Notes}")</div>
                                </div>
                                <div class="text-end mono" style="font-size:0.78rem;flex-shrink:0">
                                    @(daysLeft <= 0 ? "today" : daysLeft == 1 ? "tomorrow" : $"in {daysLeft}d")
                                    <div class="row-meta">@item.Session.PlannedDate.ToString("MMM d")</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <!-- Subjects -->
    <div>
        @if (!Model.Subjects.Any())
        {
            <div class="empty mt-4">
                <div class="empty-glyph">∅</div>
                <p class="empty-text">Your ledger is empty. Add subjects by hand, or pull them straight from FINKI.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="Subjects" asp-action="Create" class="btn btn-primary btn-sm">Add a subject</a>
                    <a asp-controller="Import" asp-action="Index" class="btn btn-outline-secondary btn-sm">Import from FINKI</a>
                </div>
            </div>
        }
        else
        {
            @foreach (var semester in Model.Subjects.GroupBy(s => s.Semester).OrderBy(g => g.Key))
            {
                <div class="section-title">Semester @semester.Key</div>
                <div class="ledger">
                    @foreach (var s in semester)
                    {
                        <a asp-controller="Subjects" asp-action="Details" asp-route-id="@s.Id"
                           class="ledger-row @(s.IsCompleted ? "done" : "")">
                            <div>
                                <div class="row-title">
                                    @s.Name
                                    @if (s.HasLab) { <span class="tag ms-2">Lab</span> }
                                    @if (s.IsCompleted) { <span class="tag tag-sage ms-1">Done</span> }
                                </div>
                                <div class="row-meta">@s.Credits cr · confidence @s.ConfidenceLevel/10</div>
                            </div>
                            @if (s.FinalGrade.HasValue)
                            {
                                <div class="row-grade">
                                    @s.FinalGrade.Value.ToString("F1")%
                                    <small>grade @GradeHelper.ToFinkiGrade(s.FinalGrade.Value)</small>
                                </div>
                            }
                        </a>
                    }
                </div>
            }
        }
    </div>

</div>
