@model academic_weapon.Models.Subject
@{
    ViewData["Title"] = "Edit Subject";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4">Edit Subject</h2>
        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden"/>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="row g-2 mb-3">
                <div class="col">
                    <label asp-for="Credits" class="form-label"></label>
                    <input asp-for="Credits" class="form-control" type="number" min="0" max="12"/>
                </div>
                <div class="col">
                    <label asp-for="Semester" class="form-label"></label>
                    <input asp-for="Semester" class="form-control" type="number" min="1" max="12"/>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfidenceLevel" class="form-label">Confidence (0–10)</label>
                <input asp-for="ConfidenceLevel" class="form-control" type="number" min="0" max="10"/>
            </div>
            <div class="mb-3">
                <label asp-for="FinalGrade" class="form-label">Final Grade (%)</label>
                <input asp-for="FinalGrade" class="form-control" type="number" step="0.1" min="0" max="100"/>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="HasLab" class="form-check-input" type="checkbox"/>
                <label asp-for="HasLab" class="form-check-label">Has Lab</label>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="IsCompleted" class="form-check-input" type="checkbox"/>
                <label asp-for="IsCompleted" class="form-check-label">Completed</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}