@model academic_weapon.Models.Subject
@{
    ViewData["Title"] = "Delete Subject";
}

<div class="row justify-content-center reveal">
    <div class="col-md-6 col-lg-5">
        <div class="page-head">
            <div class="page-kicker" style="color:var(--clay)">Irreversible</div>
            <h1 class="page-title">Delete this subject?</h1>
            <p class="page-sub">This removes the subject and all of its grading components, notes, materials, assignments, and study sessions.</p>
        </div>

        <div class="panel mb-4">
            <div class="row-title mb-1">@Model.Name</div>
            <div class="row-meta">
                Semester @Model.Semester · @Model.Credits credits
                @if (Model.HasLab) { <span class="tag ms-2">Lab</span> }
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.Id"/>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete permanently</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
