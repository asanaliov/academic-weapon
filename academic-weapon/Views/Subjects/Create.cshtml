@model academic_weapon.Models.Subject
@{
    ViewData["Title"] = "Add Subject";
}

<div class="row justify-content-center reveal">
    <div class="col-md-6 col-lg-5">
        <div class="page-head">
            <div class="page-kicker">New entry</div>
            <h1 class="page-title">Add a subject</h1>
        </div>
        <div class="panel">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Calculus II" autofocus/>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col">
                        <label asp-for="Credits" class="form-label">Credits (ECTS)</label>
                        <input asp-for="Credits" class="form-control" type="number" min="0" max="12"/>
                    </div>
                    <div class="col">
                        <label asp-for="Semester" class="form-label"></label>
                        <input asp-for="Semester" class="form-control" type="number" min="1" max="12"/>
                    </div>
                    <div class="col">
                        <label asp-for="ConfidenceLevel" class="form-label">Confidence</label>
                        <input asp-for="ConfidenceLevel" class="form-control" type="number" min="0" max="10"/>
                    </div>
                </div>
                <div class="mb-2 form-check">
                    <input asp-for="HasLab" class="form-check-input" type="checkbox"/>
                    <label asp-for="HasLab" class="form-check-label">Has lab exercises</label>
                </div>
                <div class="mb-4 form-check">
                    <input asp-for="IsCompleted" class="form-check-input" type="checkbox"/>
                    <label asp-for="IsCompleted" class="form-check-label">Already completed</label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add subject</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
