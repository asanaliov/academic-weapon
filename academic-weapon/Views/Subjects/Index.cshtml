@using academic_weapon.Helpers
@model List<academic_weapon.Models.Subject>
@{
    ViewData["Title"] = "Subjects";
    var query = ViewBag.Query as string;
}

<div class="reveal">

    <div class="page-head d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <div class="page-kicker">Your ledger</div>
            <h1 class="page-title">Subjects</h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Export" class="btn btn-outline-secondary btn-sm">Export CSV</a>
            <a asp-action="Create" class="btn btn-primary btn-sm">+ Add subject</a>
        </div>
    </div>

    <form method="get" class="mb-4" style="max-width:340px">
        <input type="search" name="q" value="@query" class="form-control"
               placeholder="Search subjects…" onsearch="this.form.submit()"/>
    </form>

    @if (!Model.Any())
    {
        <div class="empty">
            <div class="empty-glyph">∅</div>
            @if (string.IsNullOrWhiteSpace(query))
            {
                <p class="empty-text">No subjects yet. Add them by hand or import your FINKI courses in one go.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="Create" class="btn btn-primary btn-sm">Add a subject</a>
                    <a asp-controller="Import" asp-action="Index" class="btn btn-outline-secondary btn-sm">Import from FINKI</a>
                </div>
            }
            else
            {
                <p class="empty-text">Nothing matches “@query”.</p>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear search</a>
            }
        </div>
    }
    else
    {
        @foreach (var semester in Model.GroupBy(s => s.Semester).OrderBy(g => g.Key))
        {
            <div class="section-title">Semester @semester.Key</div>
            <div class="ledger">
                @foreach (var s in semester)
                {
                    <a asp-action="Details" asp-route-id="@s.Id" class="ledger-row @(s.IsCompleted ? "done" : "")">
                        <div>
                            <div class="row-title">
                                @s.Name
                                @if (s.HasLab) { <span class="tag ms-2">Lab</span> }
                                @if (s.IsCompleted) { <span class="tag tag-sage ms-1">Done</span> }
                            </div>
                            <div class="row-meta">@s.Credits cr · confidence @s.ConfidenceLevel/10</div>
                        </div>
                        @if (s.FinalGrade.HasValue)
                        {
                            <div class="row-grade">
                                @s.FinalGrade.Value.ToString("F1")%
                                <small>grade @GradeHelper.ToFinkiGrade(s.FinalGrade.Value)</small>
                            </div>
                        }
                    </a>
                }
            </div>
        }
    }

</div>
