@model List<academic_weapon.Models.Subject>
@{
    ViewData["Title"] = "Subjects";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Subjects</h2>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add Subject</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted fs-5">No subjects yet.</p>
        <a asp-action="Create" class="btn btn-primary">Add your first subject</a>
    </div>
}
else
{
    @foreach (var semester in Model.GroupBy(s => s.Semester).OrderBy(g => g.Key))
    {
        <div class="section-title mt-3">Semester @semester.Key</div>
        @foreach (var s in semester)
        {
            <div class="subject-row @(s.IsCompleted ? "completed" : "")">
                <div>
                    <div class="subject-name">
                        @s.Name
                        @if (s.HasLab) { <span class="badge bg-secondary ms-1">Lab</span> }
                        @if (s.IsCompleted) { <span class="badge bg-success ms-1">Done</span> }
                    </div>
                    <div class="subject-meta">@s.Credits cr &middot; Semester @s.Semester &middot; Confidence @s.ConfidenceLevel/10</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (s.FinalGrade.HasValue)
                    {
                        <span style="font-family:'Playfair Display',serif;color:var(--accent);font-size:1.05rem;min-width:50px;text-align:right">
                            @s.FinalGrade.Value.ToString("F1")%
                        </span>
                    }
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </div>
        }
    }
}