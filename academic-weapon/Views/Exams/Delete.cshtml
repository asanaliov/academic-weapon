@model academic_weapon.Models.Exam
@{
    ViewData["Title"] = "Delete Exam";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3">Delete this exam?</h2>
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@Model.CourseName <span class="text-muted">(@Model.Year)</span></h5>
                <p class="card-text mb-1">@Model.Professor — @Model.ExamType</p>
                <p class="card-text text-muted small mb-0">File: @Model.OriginalFileName</p>
            </div>
        </div>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete permanently</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
