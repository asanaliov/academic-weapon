@model academic_weapon.Models.Exam
@{
    ViewData["Title"] = "Delete Exam";
}

<div class="row justify-content-center reveal">
    <div class="col-md-6 col-lg-5">
        <div class="page-head">
            <div class="page-kicker" style="color:var(--clay)">Irreversible</div>
            <h1 class="page-title">Delete this exam?</h1>
            <p class="page-sub">The file and all of its ratings will be removed from the archive.</p>
        </div>

        <div class="panel mb-4">
            <div class="row-title mb-1">@Model.CourseName <span class="wisp">(@Model.Year)</span></div>
            <div class="row-meta">@Model.Professor · @Model.ExamType · @Model.OriginalFileName</div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete permanently</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
