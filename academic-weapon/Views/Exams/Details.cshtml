@model academic_weapon.ViewModels.ExamDetailsViewModel
@{
    ViewData["Title"] = Model.Exam.CourseName + " exam";
    var isImage = Model.Exam.ContentType.StartsWith("image/");
}

<div class="reveal">

    <div class="page-head d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <div class="page-kicker">@Model.Exam.ExamType · @Model.Exam.Year</div>
            <h1 class="page-title">@Model.Exam.CourseName</h1>
            <p class="page-sub">
                @Model.Exam.Professor
                @if (!string.IsNullOrWhiteSpace(Model.Exam.CourseCode))
                {
                    <span class="mono ms-1" style="font-size:0.78rem">· @Model.Exam.CourseCode</span>
                }
            </p>
        </div>
        @if (Model.CanManage)
        {
            <div class="d-flex gap-2 flex-shrink-0">
                <a asp-action="Edit" asp-route-id="@Model.Exam.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Exam.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </div>
        }
    </div>

    <div class="row g-3">
        <div class="col-md-7">
            <div class="panel mb-3">
                <div class="panel-label">The exam</div>
                @if (isImage)
                {
                    <img src="@Model.Exam.FilePath" alt="Exam preview" class="img-fluid rounded mb-3" style="border:1px solid var(--line)"/>
                }
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Download" asp-route-id="@Model.Exam.Id" class="btn btn-primary btn-sm">Download</a>
                    <a href="@Model.Exam.FilePath" target="_blank" class="btn btn-outline-secondary btn-sm">Open in new tab</a>
                </div>
                <div class="row-meta mt-2">@Model.Exam.OriginalFileName</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Exam.Description))
            {
                <div class="panel">
                    <div class="panel-label">Notes from the uploader</div>
                    <p class="mb-0" style="white-space:pre-wrap;font-size:0.9rem">@Model.Exam.Description</p>
                </div>
            }
        </div>

        <div class="col-md-5">
            <div class="panel mb-3">
                <div class="panel-label">Difficulty</div>
                @if (Model.AverageDifficulty.HasValue)
                {
                    <div class="stat-value" style="font-size:2.4rem">
                        <span class="accent">@Model.AverageDifficulty.Value.ToString("0.0")</span><small>/ 5</small>
                    </div>
                    <div class="stat-sub">from @Model.RatingCount @(Model.RatingCount == 1 ? "rating" : "ratings")</div>
                }
                else
                {
                    <p class="text-muted mb-0" style="font-size:0.88rem">Not rated yet.</p>
                }

                <hr/>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="Rate" method="post" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="examId" value="@Model.Exam.Id"/>
                        <label class="form-label mb-0">Your rating</label>
                        <select name="score" class="form-select form-select-sm" style="width:auto">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <option value="@i" selected="@(Model.UserRating == i)">@i</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            @(Model.UserRating.HasValue ? "Update" : "Rate")
                        </button>
                    </form>
                }
                else
                {
                    <p class="mb-0" style="font-size:0.82rem">
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Url.Action("Details", "Exams", new { id = Model.Exam.Id })">Log in</a>
                        <span class="text-muted">to rate this exam.</span>
                    </p>
                }
            </div>

            <div class="panel">
                <div class="row-meta">
                    Uploaded by <span style="color:var(--paper)">@Model.UploaderName</span> · @Model.Exam.UploadedAt.ToString("d MMM yyyy")
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" style="font-size:0.82rem">← Back to the archive</a>
    </div>

</div>
