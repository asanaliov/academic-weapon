@model academic_weapon.ViewModels.ExamIndexViewModel
@{
    ViewData["Title"] = "Exam Autopsy";
}

<div class="reveal">

    <div class="page-head d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <div class="page-kicker">Community archive</div>
            <h1 class="page-title">Exam Autopsy</h1>
            <p class="page-sub">Past exams shared by students — tagged by course, professor, and year. Browse freely; log in to contribute.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm flex-shrink-0">Upload an exam</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <select name="course" class="form-select form-select-sm" asp-items="@(new SelectList(Model.CourseOptions, Model.Course))" onchange="this.form.submit()">
                <option value="">All courses</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="professor" class="form-select form-select-sm" asp-items="@(new SelectList(Model.ProfessorOptions, Model.Professor))" onchange="this.form.submit()">
                <option value="">All professors</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="year" class="form-select form-select-sm" asp-items="@(new SelectList(Model.YearOptions, Model.Year))" onchange="this.form.submit()">
                <option value="">All years</option>
            </select>
        </div>
        <div class="col-md-3">
            @if (!string.IsNullOrEmpty(Model.Course) || !string.IsNullOrEmpty(Model.Professor) || Model.Year.HasValue)
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset filters</a>
            }
        </div>
    </form>

    @if (!Model.Exams.Any())
    {
        <div class="empty">
            <div class="empty-glyph">✎</div>
            <p class="empty-text">No exams in the archive yet. Be the first to upload one — future you will thank you.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm">Upload an exam</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Course</th>
                    <th>Professor</th>
                    <th>Year</th>
                    <th>Type</th>
                    <th>Difficulty</th>
                    <th>Uploaded by</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Exams)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Exam.Id" style="color:var(--paper);font-weight:500">@item.Exam.CourseName</a>
                            @if (!string.IsNullOrWhiteSpace(item.Exam.CourseCode))
                            {
                                <span class="row-meta d-block">@item.Exam.CourseCode</span>
                            }
                        </td>
                        <td class="text-muted">@item.Exam.Professor</td>
                        <td class="mono" style="font-size:0.8rem">@item.Exam.Year</td>
                        <td><span class="tag">@item.Exam.ExamType</span></td>
                        <td>
                            @if (item.AverageDifficulty.HasValue)
                            {
                                <span class="serif-num" style="color:var(--brass)">@item.AverageDifficulty.Value.ToString("0.0")</span>
                                <span class="row-meta">/ 5 (@item.RatingCount)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-muted" style="font-size:0.82rem">@item.UploaderName</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Exam.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

</div>
