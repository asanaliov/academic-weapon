@{
    ViewData["Title"] = "Import Courses";
}

<div class="row justify-content-center reveal">
    <div class="col-md-7 col-lg-6">

        <div class="page-head">
            <div class="page-kicker">One-click setup</div>
            <h1 class="page-title">Import from FINKI</h1>
            <p class="page-sub">
                Log in with your CAS credentials and your enrolled Moodle courses are pulled in as subjects —
                names, semesters, and course links included. Credentials are used for this one request and never stored.
            </p>
        </div>

        <div class="panel mb-4">
            <form asp-action="Finki" method="post" id="finki-form">
                <div class="mb-3">
                    <label class="form-label">FINKI username</label>
                    <input type="text" name="username" class="form-control" placeholder="e.g. asan.aliov" autocomplete="username" required/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" autocomplete="current-password" required/>
                </div>
                <details class="mb-4">
                    <summary class="text-muted" style="cursor:pointer;font-size:0.78rem">Advanced — custom courses URL</summary>
                    <div class="mt-2">
                        <input type="url" name="coursesUrl" class="form-control"
                               value="https://courses.finki.ukim.mk/"
                               placeholder="https://courses.finki.ukim.mk/"/>
                        <div class="form-text" style="font-size:0.72rem">
                            Only change this if your courses live on a different Moodle instance.
                        </div>
                    </div>
                </details>
                <button type="submit" class="btn btn-primary w-100" id="finki-submit">Import my courses</button>
                <div class="text-center mt-2 mono" style="font-size:0.68rem;color:var(--faint)">
                    takes ~10 seconds — logging in through CAS and asking Moodle for your enrolments
                </div>
            </form>
        </div>

        <!-- Manual fallback -->
        <details>
            <summary class="text-muted" style="cursor:pointer;font-size:0.82rem;margin-bottom:0.75rem">
                Prefer not to enter your password? Manual import
            </summary>
            <div class="panel mt-2">
                <p class="text-muted mb-2" style="font-size:0.8rem">
                    Paste a JSON array of courses. Minimal shape:
                    <code class="mono" style="font-size:0.72rem;color:var(--brass)">[{"name":"Calculus II","credits":6,"semester":2}]</code>
                </p>
                <form asp-action="Manual" method="post">
                    <div class="mb-3">
                        <textarea name="json" class="form-control" rows="6"
                                  placeholder='[{"name":"Calculus II","credits":6,"semester":2,"hasLab":false}]'
                                  style="font-family:var(--font-mono);font-size:0.78rem"></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-primary btn-sm">Import JSON</button>
                </form>
            </div>
        </details>

        @if (TempData["DebugHtml"] is string debug && !string.IsNullOrWhiteSpace(debug))
        {
            <details class="mt-3">
                <summary class="text-muted" style="cursor:pointer;font-size:0.76rem">Debug — page HTML snippet</summary>
                <pre class="mono" style="font-size:0.68rem;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:1rem;overflow-x:auto;max-height:300px;color:var(--faint)">@debug</pre>
            </details>
        }

    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('finki-form').addEventListener('submit', function () {
            var btn = document.getElementById('finki-submit');
            btn.disabled = true;
            btn.textContent = 'Importing… talking to FINKI';
        });
    </script>
}
