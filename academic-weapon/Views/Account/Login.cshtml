@model academic_weapon.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4">Log in</h2>
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control"/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control"/>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox"/>
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button type="submit" class="btn btn-primary">Log in</button>
                <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-link">Create an account</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
